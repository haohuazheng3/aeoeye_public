# AEOeye —— 环境变量模板
#
# 复制成 .env.local 后填值。.env.local 已被 .gitignore 挡住,永远不要提交。
# 变量的权威定义在 lib/env.ts(zod 校验),这份模板与它保持一致。

# ── 基础 ────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 数据库(唯一硬性必填)────────────────────────────────
# Neon Postgres。UNPOOLED 供迁移用:DDL 经连接池可能落在不同后端连接上,
# 迁移中途换连接会留下半套表结构。
DATABASE_URL=postgres://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# ── 分析层与主引擎(缺它审计跑不起来)──────────────────
# 出题 / 判卷 / 汇总,以及受测的 ChatGPT 引擎,全部走这一个 key。
OPENAI_API=

# 分析模型:免费报告用 FREE,付费报告用 FULL(最强档)。
# ⚠️ 付费档的变量名是 LLM_MODEL_FULL 而不是 LLM_MODEL —— 后者是废弃名,
#    留着它只会让部署环境里的旧值静默覆盖新配置。
LLM_MODEL_FULL=gpt-5.6-sol
LLM_MODEL_FREE=gpt-5.6-luna
LLM_MODEL_CHEAP=gpt-5.6-luna

# 受测引擎的模型 —— 必须对标各家**免费用户**默认拿到的那一档。
# 调强等于伪造用户体验:买家在免费 ChatGPT 里问,拿到的就是这一档回答。
LLM_MODEL_ENGINE_GPT=gpt-5.6-luna
LLM_MODEL_ENGINE=claude-sonnet-5

# ── 其余四个受测引擎(Claude / Gemini / Google AI / Perplexity)──
# 都经 DataForSEO 的 AI Optimization 端点。缺它时这四个引擎会如实标成
# inactive,不会用别家顶替。base64("login:password")
DATAFORSEO_B64=

# ── 抓站与性能数据 ──────────────────────────────────────
FIRECRAWL_API_KEY=
PSI_API=

# ── 登录(Clerk)──────────────────────────────────────────
# ⚠️ NEXT_PUBLIC_* 是**构建期**内联进浏览器 bundle 的,构建时就必须有真值。
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── 支付(Stripe)────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_REPORT=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ── 交易邮件(Resend)────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=AEOeye <reports@example.com>
EMAIL_REPLY_TO=contact@example.com

# ── 公开 API ───────────────────────────────────────────
# 只有这个邮箱的账号能发 API key 并调用 /api/v1/reports。
API_OWNER_EMAIL=

# ── 可选:存储、SEO 提交、定时任务 ──────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aeoeye-reports
R2_PUBLIC_URL=
GOOGLE_SERVICE_ACCOUNT_B64=
INDEXNOW_KEY=
CRON_SECRET=
NEXT_PUBLIC_CF_BEACON_TOKEN=

# ── 可选:Anthropic ────────────────────────────────────
# 目前**不参与**任何调用链 —— Claude 引擎走 DataForSEO,分析层走 OpenAI。
# 留在这里只为兼容 runTool 里那条已不可达的降级分支。
ANTHROPIC_API_KEY=
